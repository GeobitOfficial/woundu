# Copia estos valores desde Supabase Dashboard:
# Project Settings > API > Project URL y anon public (legacy: anon key)
#
# IMPORTANTE: usa la clave "anon" / "public", NO la service_role.
# Tras cambiar este archivo, reinicia `npm run dev`.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Solo servidor (Server Actions). Nunca expongas esta clave al cliente.
# Project Settings > API > service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
